# Copiar este archivo como .env y ajustar los valores.
# El .env real NO se sube al repositorio (está en el .gitignore).

# URL base de la API (obligatoria)
API_BASE_URL=https://api.open-meteo.com/v1/forecast

# API key: Open-Meteo no la pide. Si se cambia a una API que sí la requiera
# (por ejemplo OpenWeather), se carga acá y el script la envía como parámetro.
API_KEY=

# Ciudades a consultar, separadas por coma (deben existir en CIUDADES del script)
CIUDADES=Buenos Aires,Córdoba,Rosario,Mendoza,Bariloche

# Cantidad de días de pronóstico (1 a 16)
DIAS_PRONOSTICO=7

# Segundos máximos de espera por petición
TIMEOUT_SEGUNDOS=10
